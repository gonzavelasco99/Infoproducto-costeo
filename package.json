{
  "name": "costeo-organizacional",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @costeo/domain --filter @costeo/contracts --filter @costeo/database build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @costeo/api --filter @costeo/web dev",
    "dev:api": "pnpm build:shared && pnpm --filter @costeo/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @costeo/web dev",
    "dev:worker": "pnpm build:shared && pnpm --filter @costeo/worker dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
